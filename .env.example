# Veridion configuration. Copy to `.env` and fill in values.
# Every setting has a safe development default unless marked REQUIRED IN PRODUCTION.

# development | production | test
VERIDION_ENV=development

# --- API -------------------------------------------------------------------
# REQUIRED IN PRODUCTION. Signs session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# SQLite for local development; PostgreSQL in production, e.g.
#   postgresql+psycopg://veridion:password@localhost:5432/veridion
DATABASE_URL=sqlite:///./var/veridion.db

# Browser origins allowed to call the API directly (the web app normally proxies).
CORS_ORIGINS=http://localhost:3000

# Run the background worker inside the API process (handy locally).
# In production run `veridion worker` as a separate process and set this to false.
EMBEDDED_WORKER=true

# Send session cookies only over HTTPS. Set true in production.
COOKIE_SECURE=false

# Comma-separated emails allowed to read enquiries submitted through the website.
PLATFORM_ADMIN_EMAILS=

# Allow anyone to create a workspace at /sign-up. Set false for an invite-only pilot.
ALLOW_REGISTRATION=true

# API server processes for `veridion serve` (default 1).
WEB_CONCURRENCY=1

# PostgreSQL connections per process: pool size plus overflow under load. Keep
# (API processes + workers) x (pool + overflow) below the server's max_connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Proxies whose X-Forwarded-For header the API trusts (IPs or CIDR ranges). Only list
# hosts that sit between the internet and the API, e.g. the web server's network.
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# --- Document storage ------------------------------------------------------
# local | s3 (any S3-compatible store: AWS S3, Cloudflare R2, MinIO)
STORAGE_BACKEND=local
STORAGE_DIR=./var/storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OCR for scanned PDFs (requires the `tesseract` binary).
OCR_ENABLED=true

# --- AI / LLM (optional) ---------------------------------------------------
# groq | openai_compatible | none
# With `none`, Veridion runs the deterministic rules-only assessment.
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# For openai_compatible providers (e.g. a local Ollama server):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
LLM_BASE_URL=
LLM_API_KEY=
LLM_MAX_CONCURRENCY=2
LLM_TIMEOUT_SECONDS=60

# --- Web -------------------------------------------------------------------
# Where the Next.js server proxies /api/* requests. Fixed at build time for production builds.
VERIDION_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- docker compose (docker-compose.yml) ---------------------------------------
# The stack runs in production mode, so SECRET_KEY above must be set.
POSTGRES_PASSWORD=change-me
SITE_URL=http://localhost:3000
WEB_PORT=3000
API_WORKERS=2
