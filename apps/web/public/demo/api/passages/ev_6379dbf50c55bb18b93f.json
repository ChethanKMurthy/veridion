{"id":"ev_6379dbf50c55bb18b93f","document_id":"doc_01m4gcq87h4j5h63ktsgbydhxr","page":4,"ordinal":18,"kind":"heading","section":"Energy and resources","text":"Energy and resources","bbox":[72.5,87.6,272.1,113.8],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":{"id":"doc_01m4gcq87h4j5h63ktsgbydhxr","title":"Tessaline Building Products \u2014 Annual and Sustainability Report 2024/25","short_name":"Sustainability report FY2025","version":1,"doc_type":"sustainability_report","period_label":"FY2025","page_sizes":[[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0]],"superseded_at":null},"page_passages":[{"id":"ev_6379dbf50c55bb18b93f","kind":"heading","bbox":[72.5,87.6,272.1,113.8],"text":"Energy and resources"},{"id":"ev_cdab2950290dba9bce3c","kind":"paragraph","bbox":[72.5,124.2,488.8,170.1],"text":"Total energy consumption in FY2024/25 was 1,298,000 GJ (FY2023/24: 1,342,600 GJ). Purchased electricity consumption was 61,200 MWh, of which 58% was supplied under a renewable power purchase agreement."},{"id":"ev_cef053005e93d5561c45","kind":"paragraph","bbox":[72.5,177.9,448.5,193.3],"text":"Water withdrawal was 365 megalitres and we generated 15,100 tonnes of waste."},{"id":"ev_9ced4ee4ab01d36bff08","kind":"paragraph","bbox":[72.5,201.1,502.1,231.8],"text":"Fuel switching from coal to natural gas and biomass at our Brandon tile plant contributed to lower Scope 1 emissions during the year."},{"id":"ev_28b790b982cbc73bdf13","kind":"heading","bbox":[72.5,246.8,117.6,264.1],"text":"Targets"},{"id":"ev_8a251d6197925de71769","kind":"paragraph","bbox":[72.5,268.7,492.6,284.1],"text":"We aim to reduce Scope 1 and 2 emissions by 50% by 2032 from the FY2019/20 baseline."},{"id":"ev_8317c929eeb0de3fb53b","kind":"heading","bbox":[72.5,299.2,176.0,316.4],"text":"Health and safety"},{"id":"ev_a3e7caef9c784952522d","kind":"paragraph","bbox":[72.5,321.0,510.2,336.5],"text":"The lost-time injury frequency rate (LTIFR) was 1.12 per million hours worked in FY2024/25."}],"metrics":[],"cited_by":[{"finding_id":"fnd_01m4gcx1677r45bm70rdy86810","requirement_code":"302-4","status":"partially_supported","run_id":"run_01m4gcx15fem2qrn5fz7jjyahh","role":"related"},{"finding_id":"fnd_01m4gcx166jgafz3adwtacbejk","requirement_code":"302-1","status":"partially_supported","run_id":"run_01m4gcx15fem2qrn5fz7jjyahh","role":"related"}]}