{"id":"ev_8080137dea4660994ecd","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":3,"ordinal":17,"kind":"paragraph","section":"Our approach to climate change \u203a Targets","text":"In the 2019 base year, Scope 1 and 2 emissions were 81,600 tCO2e. Base-year emissions are recalculated when acquisitions or divestments change emissions by more than 5%.","bbox":[72.5,245.5,500.9,276.1],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":{"id":"doc_01m4gcq87e5k9e321mrzfz2y6h","title":"Aldermere Materials Group \u2014 Sustainability Report 2025","short_name":"Sustainability report FY2025","version":1,"doc_type":"sustainability_report","period_label":"FY2025","page_sizes":[[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0]],"superseded_at":null},"page_passages":[{"id":"ev_73cbc641d6d6aa9f602c","kind":"heading","bbox":[72.5,87.6,362.9,113.8],"text":"Our approach to climate change"},{"id":"ev_57efdd9baf0bdf7a5aab","kind":"paragraph","bbox":[72.5,124.2,499.5,170.1],"text":"The Board's Sustainability Committee oversees climate-related risks and opportunities and reviews progress against our decarbonisation roadmap twice a year. Climate performance is included in the annual bonus scorecard for executive directors."},{"id":"ev_13c7bc0fc46f813619fe","kind":"heading","bbox":[72.5,185.2,117.6,202.4],"text":"Targets"},{"id":"ev_a1014c2e5380f469990d","kind":"paragraph","bbox":[72.5,207.0,520.4,237.7],"text":"We have committed to reduce absolute Scope 1 and 2 emissions by 42% by 2030 against a 2019 base year, and to reach net zero across our operations by 2050."},{"id":"ev_8080137dea4660994ecd","kind":"paragraph","bbox":[72.5,245.5,500.9,276.1],"text":"In the 2019 base year, Scope 1 and 2 emissions were 81,600 tCO2e. Base-year emissions are recalculated when acquisitions or divestments change emissions by more than 5%."},{"id":"ev_ccdfb26dc47e949312f9","kind":"heading","bbox":[72.5,291.2,195.5,308.4],"text":"Climate-related risks"},{"id":"ev_3514dd78470ae971f5fc","kind":"paragraph","bbox":[72.5,313.0,513.7,358.9],"text":"Our most significant transition risk is the rising cost of carbon allowances and natural gas used in kilns. Physical risks include flooding at two riverside plants. Both risks are recorded on the Group risk register and reviewed by the Audit and Risk Committee."}],"metrics":[{"id":"met_01m4gcq8fa5f2ggwp4np4wtfwe","metric_key":"ghg_scope1_2","label":"Scope 1 and 2 GHG emissions","value":81600.0,"unit":"tCO2e","normalized_value":81600.0,"normalized_unit":"tCO2e","period_label":"FY2019","qualifiers":{"base_year":true},"confidence":0.85}],"cited_by":[{"finding_id":"fnd_01m4gcx10srd6vnxttpf51cax0","requirement_code":"305-5","status":"supported","run_id":"run_01m4gcwx38x017m8c6wg7f8vyf","role":"supporting"},{"finding_id":"fnd_01m4gcx10nft809mzef6max5fg","requirement_code":"305-2","status":"partially_supported","run_id":"run_01m4gcwx38x017m8c6wg7f8vyf","role":"related"},{"finding_id":"fnd_01m4gcx10ksyweb41mn8jhddj8","requirement_code":"305-1","status":"partially_supported","run_id":"run_01m4gcwx38x017m8c6wg7f8vyf","role":"supporting"},{"finding_id":"fnd_01m4gcwwyg06bamaheyqvenjc6","requirement_code":"305-5","status":"supported","run_id":"run_01m4gcq9cmbf3mze3bpf7pk5hk","role":"supporting"},{"finding_id":"fnd_01m4gcwwydr9j8qh3ycqts7sms","requirement_code":"305-2","status":"supported","run_id":"run_01m4gcq9cmbf3mze3bpf7pk5hk","role":"related"},{"finding_id":"fnd_01m4gcwwy9s2fjyj7b00w6c8n9","requirement_code":"305-1","status":"supported","run_id":"run_01m4gcq9cmbf3mze3bpf7pk5hk","role":"supporting"}]}