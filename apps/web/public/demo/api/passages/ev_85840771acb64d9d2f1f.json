{"id":"ev_85840771acb64d9d2f1f","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":7,"ordinal":52,"kind":"paragraph","section":"Reducing energy use and emissions","text":"Kiln heat-recovery projects at our Ashby and Kelso plants and the replacement of fourteen diesel loaders with electric models reduced Scope 1 emissions by 2,350 tCO2e in 2025 compared with 2024.","bbox":[72.5,124.2,521.6,170.1],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":{"id":"doc_01m4gcq87e5k9e321mrzfz2y6h","title":"Aldermere Materials Group \u2014 Sustainability Report 2025","short_name":"Sustainability report FY2025","version":1,"doc_type":"sustainability_report","period_label":"FY2025","page_sizes":[[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0]],"superseded_at":null},"page_passages":[{"id":"ev_1d56380532a9c864e787","kind":"heading","bbox":[72.5,87.6,401.9,113.8],"text":"Reducing energy use and emissions"},{"id":"ev_85840771acb64d9d2f1f","kind":"paragraph","bbox":[72.5,124.2,521.6,170.1],"text":"Kiln heat-recovery projects at our Ashby and Kelso plants and the replacement of fourteen diesel loaders with electric models reduced Scope 1 emissions by 2,350 tCO2e in 2025 compared with 2024."},{"id":"ev_f38d48c444a257dbd8bd","kind":"paragraph","bbox":[72.5,177.9,508.5,208.5],"text":"Efficiency projects delivered energy savings of 6,800 MWh in 2025 against the 2024 baseline, mainly through reduced natural gas use in kilns and dryers."},{"id":"ev_38e71ea9fb6df67fb85d","kind":"heading","bbox":[72.5,223.6,171.1,240.8],"text":"Water and waste"},{"id":"ev_ee3e4dfefc888cf32cf5","kind":"paragraph","bbox":[72.5,245.5,507.8,276.1],"text":"Water withdrawal was 412 megalitres in 2025 (2024: 428 megalitres), drawn from municipal supplies and on-site boreholes."},{"id":"ev_8471ac69985593296660","kind":"paragraph","bbox":[72.5,283.9,500.0,314.6],"text":"We generated 18,400 tonnes of waste in 2025, most of which was recycled as fired clay and concrete fines."},{"id":"ev_598e85fd2499638004c8","kind":"heading","bbox":[72.5,329.6,176.0,346.9],"text":"Health and safety"},{"id":"ev_48abaa9a3108678728fc","kind":"paragraph","bbox":[72.5,351.5,511.9,382.1],"text":"Our lost-time injury frequency rate (LTIFR) was 0.82 per million hours worked in 2025 (2024: 0.95)."}],"metrics":[{"id":"met_01m4gcq8favt2kq3aryq0j3cdj","metric_key":"ghg_reduction","label":"GHG emissions reduced through initiatives","value":2350.0,"unit":"tCO2e","normalized_value":2350.0,"normalized_unit":"tCO2e","period_label":"FY2025","qualifiers":{},"confidence":0.85}],"cited_by":[{"finding_id":"fnd_01m4gcx10vnnnxefmzav4rksfn","requirement_code":"302-4","status":"supported","run_id":"run_01m4gcwx38x017m8c6wg7f8vyf","role":"supporting"},{"finding_id":"fnd_01m4gcx10srd6vnxttpf51cax0","requirement_code":"305-5","status":"supported","run_id":"run_01m4gcwx38x017m8c6wg7f8vyf","role":"supporting"},{"finding_id":"fnd_01m4gcwwykmej1c28k3nezqazb","requirement_code":"302-4","status":"supported","run_id":"run_01m4gcq9cmbf3mze3bpf7pk5hk","role":"supporting"},{"finding_id":"fnd_01m4gcwwyg06bamaheyqvenjc6","requirement_code":"305-5","status":"supported","run_id":"run_01m4gcq9cmbf3mze3bpf7pk5hk","role":"supporting"}]}