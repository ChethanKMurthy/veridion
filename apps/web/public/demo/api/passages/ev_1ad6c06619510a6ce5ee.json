{"id":"ev_1ad6c06619510a6ce5ee","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":5,"ordinal":35,"kind":"heading","section":"Value chain emissions","text":"Value chain emissions","bbox":[72.5,87.6,276.3,113.8],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":{"id":"doc_01m4gcq87e5k9e321mrzfz2y6h","title":"Aldermere Materials Group \u2014 Sustainability Report 2025","short_name":"Sustainability report FY2025","version":1,"doc_type":"sustainability_report","period_label":"FY2025","page_sizes":[[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0]],"superseded_at":null},"page_passages":[{"id":"ev_1ad6c06619510a6ce5ee","kind":"heading","bbox":[72.5,87.6,276.3,113.8],"text":"Value chain emissions"},{"id":"ev_694511f1232e6d142683","kind":"paragraph","bbox":[72.5,124.2,507.9,185.3],"text":"We have begun screening our Scope 3 emissions across the 15 categories of the GHG Protocol Corporate Value Chain (Scope 3) Standard. Purchased goods and services (Category 1) and upstream transportation and distribution (Category 4) are expected to be the most significant categories."},{"id":"ev_f020cd7dfb4a87ec152a","kind":"paragraph","bbox":[72.5,193.1,501.3,223.8],"text":"Scope 3 emissions have not yet been quantified. We expect to report them for 2026, starting with Categories 1 and 4."},{"id":"ev_29b8dcc84b1336c8c65e","kind":"heading","bbox":[72.5,238.8,210.0,256.1],"text":"Working with suppliers"},{"id":"ev_62517b97b07ac00e57f7","kind":"paragraph","bbox":[72.5,260.7,520.2,306.6],"text":"In 2025 we asked our 40 largest suppliers to share product carbon footprints. Eighteen suppliers responded, and we will use their data to prioritise lower-carbon cement and aggregate purchases."}],"metrics":[],"cited_by":[{"finding_id":"fnd_01m4gcx10q960bt2q7w9xx30cq","requirement_code":"305-3","status":"partially_supported","run_id":"run_01m4gcwx38x017m8c6wg7f8vyf","role":"related"},{"finding_id":"fnd_01m4gcwwyfs3ddn6ny3vfztnpf","requirement_code":"305-3","status":"partially_supported","run_id":"run_01m4gcq9cmbf3mze3bpf7pk5hk","role":"related"}]}