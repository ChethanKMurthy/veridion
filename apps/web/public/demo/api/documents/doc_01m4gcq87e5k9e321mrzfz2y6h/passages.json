[{"id":"ev_d9f32a2e3b5e10209a8d","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":1,"ordinal":0,"kind":"paragraph","section":null,"text":"Aldermere Materials Group","bbox":[72.5,287.4,204.5,302.6],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_9cc33e5b557abe242402","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":1,"ordinal":1,"kind":"paragraph","section":null,"text":"Reporting period: 1 January 2025 \u2013 31 December 2025","bbox":[72.5,364.9,366.0,381.3],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_7044b75049e66b5077fc","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":1,"ordinal":2,"kind":"paragraph","section":null,"text":"Fictional sample document. Created by Veridion for demonstration and testing. The company, people, sites and figures are invented and do not describe any real organization.","bbox":[72.5,542.4,519.0,566.4],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_ecadbbbbfd1923af4bf8","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":2,"ordinal":3,"kind":"heading","section":"About this report","text":"About this report","bbox":[72.5,87.6,226.6,113.8],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_cd2ec30f5a00db01e6c6","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":2,"ordinal":4,"kind":"paragraph","section":"About this report","text":"This report covers the sustainability performance of Aldermere Materials Group plc and its subsidiaries for the year ended 31 December 2025. It has been prepared with reference to the GRI Standards.","bbox":[72.5,124.2,507.9,170.1],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_297fed5e7afad897829a","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":2,"ordinal":5,"kind":"heading","section":"About this report \u203a About Aldermere","text":"About Aldermere","bbox":[72.5,185.2,173.9,202.4],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_c2bfbe97516324527282","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":2,"ordinal":6,"kind":"paragraph","section":"About this report \u203a About Aldermere","text":"Aldermere manufactures clay bricks, precast concrete products and mineral insulation for the UK construction market. In 2025 we produced 408,000 tonnes of product from seven manufacturing plants and employed 1,940 people.","bbox":[72.5,207.0,506.8,252.9],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_40d0b54df032bbb739dd","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":2,"ordinal":7,"kind":"heading","section":"About this report \u203a Reporting boundary","text":"Reporting boundary","bbox":[72.5,268.0,191.9,285.2],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_eb323b4dbf22143b6977","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":2,"ordinal":8,"kind":"paragraph","section":"About this report \u203a Reporting boundary","text":"Environmental data covers the seven manufacturing plants and two distribution depots over which we have operational control. We report greenhouse gas emissions using the operational control approach.","bbox":[72.5,289.8,510.3,335.7],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_7a980ba60646b0051f3e","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":2,"ordinal":9,"kind":"heading","section":"About this report \u203a External assurance","text":"External assurance","bbox":[72.5,350.8,187.1,368.0],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_eb68fa39504adcf37478","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":2,"ordinal":10,"kind":"paragraph","section":"About this report \u203a External assurance","text":"Our 2025 environmental and safety data has not been externally assured. The Audit and Risk Committee reviewed the data collection process, and we intend to obtain limited assurance over Scope 1 and 2 emissions for 2026.","bbox":[72.5,372.6,520.1,418.5],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_e53defcafa3f77bb1748","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":2,"ordinal":11,"kind":"heading","section":"About this report \u203a Restatements","text":"Restatements","bbox":[72.5,433.6,154.5,450.8],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_e66a3c7eb45d49e92b62","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":2,"ordinal":12,"kind":"paragraph","section":"About this report \u203a Restatements","text":"There have been no restatements of previously reported figures.","bbox":[72.5,455.4,369.7,470.8],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_73cbc641d6d6aa9f602c","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":3,"ordinal":13,"kind":"heading","section":"Our approach to climate change","text":"Our approach to climate change","bbox":[72.5,87.6,362.9,113.8],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_57efdd9baf0bdf7a5aab","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":3,"ordinal":14,"kind":"paragraph","section":"Our approach to climate change","text":"The Board's Sustainability Committee oversees climate-related risks and opportunities and reviews progress against our decarbonisation roadmap twice a year. Climate performance is included in the annual bonus scorecard for executive directors.","bbox":[72.5,124.2,499.5,170.1],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_13c7bc0fc46f813619fe","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":3,"ordinal":15,"kind":"heading","section":"Our approach to climate change \u203a Targets","text":"Targets","bbox":[72.5,185.2,117.6,202.4],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_a1014c2e5380f469990d","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":3,"ordinal":16,"kind":"paragraph","section":"Our approach to climate change \u203a Targets","text":"We have committed to reduce absolute Scope 1 and 2 emissions by 42% by 2030 against a 2019 base year, and to reach net zero across our operations by 2050.","bbox":[72.5,207.0,520.4,237.7],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_8080137dea4660994ecd","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":3,"ordinal":17,"kind":"paragraph","section":"Our approach to climate change \u203a Targets","text":"In the 2019 base year, Scope 1 and 2 emissions were 81,600 tCO2e. Base-year emissions are recalculated when acquisitions or divestments change emissions by more than 5%.","bbox":[72.5,245.5,500.9,276.1],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[{"id":"met_01m4gcq8fa5f2ggwp4np4wtfwe","metric_key":"ghg_scope1_2","value":81600.0,"unit":"tCO2e","period_label":"FY2019"}]},{"id":"ev_ccdfb26dc47e949312f9","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":3,"ordinal":18,"kind":"heading","section":"Our approach to climate change \u203a Climate-related risks","text":"Climate-related risks","bbox":[72.5,291.2,195.5,308.4],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_3514dd78470ae971f5fc","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":3,"ordinal":19,"kind":"paragraph","section":"Our approach to climate change \u203a Climate-related risks","text":"Our most significant transition risk is the rising cost of carbon allowances and natural gas used in kilns. Physical risks include flooding at two riverside plants. Both risks are recorded on the Group risk register and reviewed by the Audit and Risk Committee.","bbox":[72.5,313.0,513.7,358.9],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_7e85ddf738a5954b688e","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":4,"ordinal":20,"kind":"heading","section":"Greenhouse gas emissions","text":"Greenhouse gas emissions","bbox":[72.5,87.6,319.6,113.8],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_3c6bb58ab98e4d06fe1b","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":4,"ordinal":21,"kind":"heading","section":"Greenhouse gas emissions \u203a Methodology","text":"Methodology","bbox":[72.5,129.5,150.3,146.7],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_2c7a41045e61ada62bf8","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":4,"ordinal":22,"kind":"paragraph","section":"Greenhouse gas emissions \u203a Methodology","text":"We calculate emissions in accordance with the GHG Protocol Corporate Standard. Emission factors are taken from the UK Government GHG Conversion Factors for Company Reporting (DESNZ, 2025), and global warming potentials from the IPCC Sixth Assessment Report (AR6). Our inventory includes carbon dioxide (CO2), methane (CH4) and nitrous oxide (N2O); emissions of other greenhouse gases are not material.","bbox":[72.5,151.3,509.0,227.7],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_70918dee38ce25a137cf","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":4,"ordinal":23,"kind":"heading","section":"Greenhouse gas emissions \u203a Performance","text":"Performance","bbox":[72.5,242.7,148.9,260.0],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_7c9bc9e364dbd9e8e7a5","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":4,"ordinal":24,"kind":"paragraph","section":"Greenhouse gas emissions \u203a Performance","text":"In 2025, our gross Scope 1 emissions were 48,210 tCO2e, a 3.8% reduction compared with 2024, driven mainly by kiln heat-recovery projects. Scope 1 emissions arise from natural gas combustion in kilns and dryers, diesel used by mobile plant, and process emissions from clay.","bbox":[72.5,264.6,507.2,310.5],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[{"id":"met_01m4gcq8fay2mqf0abzwkgncts","metric_key":"ghg_scope1","value":48210.0,"unit":"tCO2e","period_label":"FY2025"}]},{"id":"ev_091d38064fed00350443","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":4,"ordinal":25,"kind":"paragraph","section":"Greenhouse gas emissions \u203a Performance","text":"Scope 2 emissions are reported using the location-based method and were 21,940 tCO2e in 2025 (2024: 23,020 tCO2e).","bbox":[72.5,318.3,496.1,348.9],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[{"id":"met_01m4gcq8faj8n467sz8anbswj2","metric_key":"ghg_scope2_location","value":21940.0,"unit":"tCO2e","period_label":"FY2025"},{"id":"met_01m4gcq8faqp6wmxkppbkc922j","metric_key":"ghg_scope2_location","value":23020.0,"unit":"tCO2e","period_label":"FY2024"}]},{"id":"ev_7915b11722a56f3a96b6","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":4,"ordinal":26,"kind":"heading","section":"Greenhouse gas emissions \u203a Performance \u203a Table 4: Greenhouse gas emissions","text":"Table 4: Greenhouse gas emissions","bbox":[72.5,362.1,251.7,376.5],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_0eadc