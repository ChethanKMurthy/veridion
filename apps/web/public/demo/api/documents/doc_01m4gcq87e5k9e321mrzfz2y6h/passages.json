wqe","metric_key":"ghg_scope1_2","value":77210.0,"unit":"tCO2e","period_label":"FY2023"}]},{"id":"ev_469e826cc3a8f7eaeae0","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":4,"ordinal":31,"kind":"table_row","section":"Greenhouse gas emissions \u203a Performance \u203a Table 4: Greenhouse gas emissions","text":"Table 4: Greenhouse gas emissions \u2014 GHG intensity (tCO2e per tonne of product): 2025: 0.172; 2024: 0.176; 2023: 0.184","bbox":[72.8,464.6,522.2,485.0],"extraction_method":"table","confidence":1.0,"table_ref":"p4-t1","cells":{"label":"GHG intensity (tCO2e per tonne of product)","values":["0.172","0.176","0.184"],"headers":["2025","2024","2023"],"caption":"Table 4: Greenhouse gas emissions"},"document":null,"metrics":[{"id":"met_01m4gcq8fat3n2y95pcgk346wc","metric_key":"ghg_intensity","value":0.172,"unit":"tCO2e/tonne of product","period_label":"FY2025"},{"id":"met_01m4gcq8favwf7h2s71y78j8sa","metric_key":"ghg_intensity","value":0.176,"unit":"tCO2e/tonne of product","period_label":"FY2024"},{"id":"met_01m4gcq8faz3t0fk4t8xwy300k","metric_key":"ghg_intensity","value":0.184,"unit":"tCO2e/tonne of product","period_label":"FY2023"}]},{"id":"ev_8059e8bb0c7bc2b5fb47","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":4,"ordinal":32,"kind":"paragraph","section":"Greenhouse gas emissions \u203a Performance \u203a Table 4: Greenhouse gas emissions","text":"GHG intensity covers Scope 1 and Scope 2 emissions per tonne of product.","bbox":[72.5,493.1,418.6,508.5],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_2db53390b58a47a795c3","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":4,"ordinal":33,"kind":"heading","section":"Greenhouse gas emissions \u203a Renewable electricity","text":"Renewable electricity","bbox":[72.5,523.6,199.6,540.8],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_26d6e72e3a2d83d2f0e4","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":4,"ordinal":34,"kind":"paragraph","section":"Greenhouse gas emissions \u203a Renewable electricity","text":"Since April 2024, our two largest plants have purchased renewable electricity backed by Renewable Energy Guarantees of Origin (REGOs).","bbox":[72.5,545.5,483.8,576.1],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_1ad6c06619510a6ce5ee","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":5,"ordinal":35,"kind":"heading","section":"Value chain emissions","text":"Value chain emissions","bbox":[72.5,87.6,276.3,113.8],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_694511f1232e6d142683","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":5,"ordinal":36,"kind":"paragraph","section":"Value chain emissions","text":"We have begun screening our Scope 3 emissions across the 15 categories of the GHG Protocol Corporate Value Chain (Scope 3) Standard. Purchased goods and services (Category 1) and upstream transportation and distribution (Category 4) are expected to be the most significant categories.","bbox":[72.5,124.2,507.9,185.3],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_f020cd7dfb4a87ec152a","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":5,"ordinal":37,"kind":"paragraph","section":"Value chain emissions","text":"Scope 3 emissions have not yet been quantified. We expect to report them for 2026, starting with Categories 1 and 4.","bbox":[72.5,193.1,501.3,223.8],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_29b8dcc84b1336c8c65e","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":5,"ordinal":38,"kind":"heading","section":"Value chain emissions \u203a Working with suppliers","text":"Working with suppliers","bbox":[72.5,238.8,210.0,256.1],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_62517b97b07ac00e57f7","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":5,"ordinal":39,"kind":"paragraph","section":"Value chain emissions \u203a Working with suppliers","text":"In 2025 we asked our 40 largest suppliers to share product carbon footprints. Eighteen suppliers responded, and we will use their data to prioritise lower-carbon cement and aggregate purchases.","bbox":[72.5,260.7,520.2,306.6],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_1f650850bf429e6aee76","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":6,"ordinal":40,"kind":"heading","section":"Energy","text":"Energy","bbox":[72.5,87.6,136.9,113.8],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_b24b03dc6f8c1f4e99dd","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":6,"ordinal":41,"kind":"paragraph","section":"Energy","text":"Total energy consumption within the organization was 412,300 MWh in 2025 (2024: 431,800 MWh). Fuel use is converted to energy using net calorific values from the DESNZ conversion factors.","bbox":[72.5,124.2,510.3,170.1],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[{"id":"met_01m4gcq8fa3aqtv8c5krxk7x6q","metric_key":"energy_total","value":412300.0,"unit":"MWh","period_label":"FY2025"},{"id":"met_01m4gcq8fa9pq80mbqka1hspky","metric_key":"energy_total","value":431800.0,"unit":"MWh","period_label":"FY2024"}]},{"id":"ev_099feacbfa5a0e07ab05","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":6,"ordinal":42,"kind":"heading","section":"Energy \u203a Table 5: Energy consumption","text":"Table 5: Energy consumption","bbox":[72.5,183.3,219.5,197.7],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_58339ef137b1a2f8e530","document_id":"do