1,"kind":"heading","section":"Reducing energy use and emissions","text":"Reducing energy use and emissions","bbox":[72.5,87.6,401.9,113.8],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_85840771acb64d9d2f1f","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":7,"ordinal":52,"kind":"paragraph","section":"Reducing energy use and emissions","text":"Kiln heat-recovery projects at our Ashby and Kelso plants and the replacement of fourteen diesel loaders with electric models reduced Scope 1 emissions by 2,350 tCO2e in 2025 compared with 2024.","bbox":[72.5,124.2,521.6,170.1],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[{"id":"met_01m4gcq8favt2kq3aryq0j3cdj","metric_key":"ghg_reduction","value":2350.0,"unit":"tCO2e","period_label":"FY2025"}]},{"id":"ev_f38d48c444a257dbd8bd","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":7,"ordinal":53,"kind":"paragraph","section":"Reducing energy use and emissions","text":"Efficiency projects delivered energy savings of 6,800 MWh in 2025 against the 2024 baseline, mainly through reduced natural gas use in kilns and dryers.","bbox":[72.5,177.9,508.5,208.5],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[{"id":"met_01m4gcq8fah7nt6y0e0f1ycnjx","metric_key":"energy_reduction","value":6800.0,"unit":"MWh","period_label":"FY2025"}]},{"id":"ev_38e71ea9fb6df67fb85d","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":7,"ordinal":54,"kind":"heading","section":"Reducing energy use and emissions \u203a Water and waste","text":"Water and waste","bbox":[72.5,223.6,171.1,240.8],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_ee3e4dfefc888cf32cf5","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":7,"ordinal":55,"kind":"paragraph","section":"Reducing energy use and emissions \u203a Water and waste","text":"Water withdrawal was 412 megalitres in 2025 (2024: 428 megalitres), drawn from municipal supplies and on-site boreholes.","bbox":[72.5,245.5,507.8,276.1],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[{"id":"met_01m4gcq8fabhfcrw78ybtw1ggx","metric_key":"water_withdrawal","value":412.0,"unit":"ML","period_label":"FY2025"},{"id":"met_01m4gcq8fabsk7c0h2h841mhha","metric_key":"water_withdrawal","value":428.0,"unit":"ML","period_label":"FY2024"}]},{"id":"ev_8471ac69985593296660","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":7,"ordinal":56,"kind":"paragraph","section":"Reducing energy use and emissions \u203a Water and waste","text":"We generated 18,400 tonnes of waste in 2025, most of which was recycled as fired clay and concrete fines.","bbox":[72.5,283.9,500.0,314.6],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[{"id":"met_01m4gcq8faptwm40y6qpvkc9g4","metric_key":"waste_generated","value":18400.0,"unit":"t","period_label":"FY2025"}]},{"id":"ev_598e85fd2499638004c8","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":7,"ordinal":57,"kind":"heading","section":"Reducing energy use and emissions \u203a Health and safety","text":"Health and safety","bbox":[72.5,329.6,176.0,346.9],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_48abaa9a3108678728fc","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":7,"ordinal":58,"kind":"paragraph","section":"Reducing energy use and emissions \u203a Health and safety","text":"Our lost-time injury frequency rate (LTIFR) was 0.82 per million hours worked in 2025 (2024: 0.95).","bbox":[72.5,351.5,511.9,382.1],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[{"id":"met_01m4gcq8famh7r5zxt24je70t7","metric_key":"ltifr","value":0.82,"unit":"rate","period_label":"FY2025"}]}]