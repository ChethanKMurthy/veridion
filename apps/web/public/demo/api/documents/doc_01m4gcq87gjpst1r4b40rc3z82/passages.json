[{"id":"ev_39e024d4557e4ecbd490","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":1,"ordinal":0,"kind":"paragraph","section":null,"text":"Aldermere Materials Group","bbox":[72.5,287.4,204.5,302.6],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_39ce4caa0f48488b4d98","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":1,"ordinal":1,"kind":"paragraph","section":null,"text":"For the year ended 31 December 2025","bbox":[72.5,408.4,279.3,424.8],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_086bc7ab442c0e06760f","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":1,"ordinal":2,"kind":"paragraph","section":null,"text":"Fictional sample document. Created by Veridion for demonstration and testing. The company, people, sites and figures are invented and do not describe any real organization.","bbox":[72.5,585.9,519.0,609.9],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_16f6743a9df187fd4141","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":2,"ordinal":3,"kind":"heading","section":"Chair's statement","text":"Chair's statement","bbox":[72.5,87.6,231.2,113.8],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_233b91a05a32276c51f2","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":2,"ordinal":4,"kind":"paragraph","section":"Chair's statement","text":"2025 was a year of steady progress for Aldermere. Despite subdued housing starts, revenue grew by 3.6% as demand for precast concrete products remained resilient. We continued to invest in our plants, and we remain committed to reaching net zero across our operations by 2050.","bbox":[72.5,124.2,502.9,185.3],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_f9497f7493ba7a9ff955","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":2,"ordinal":5,"kind":"paragraph","section":"Chair's statement","text":"The Board welcomed two new independent non-executive directors during the year, strengthening our expertise in energy markets and digital operations.","bbox":[72.5,193.1,463.6,223.8],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_fff6ee158dcf341acc32","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":3,"ordinal":6,"kind":"heading","section":"Financial review","text":"Financial review","bbox":[72.5,87.6,219.3,113.8],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_69791e4e70c8b092bbb8","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":3,"ordinal":7,"kind":"paragraph","section":"Financial review","text":"Revenue for the year ended 31 December 2025 was \u00a3412.6 million (2024: \u00a3398.1 million). Operating profit increased to \u00a338.9 million (2024: \u00a335.2 million), reflecting improved plant utilisation and lower energy costs in the second half.","bbox":[72.5,124.2,500.3,170.1],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_3da5911dcbfae14cc84a","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":3,"ordinal":8,"kind":"heading","section":"Financial review \u203a Financial highlights (\u00a3 million)","text":"Financial highlights (\u00a3 million)","bbox":[72.5,183.3,223.6,197.7],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_46ba2dcf3d2a321eec68","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":3,"ordinal":9,"kind":"table","section":"Financial review \u203a Financial highlights (\u00a3 million)","text":"Financial highlights (\u00a3 million)\n | 2025 | 2024\nRevenue | 412.6 | 398.1\nOperating profit | 38.9 | 35.2\nCapital expenditure | 27.4 | 22.8","bbox":[72.9,204.4,522.1,285.8],"extraction_method":"table","confidence":1.0,"table_ref":"p3-t1","cells":{"caption":"Financial highlights (\u00a3 million)","headers":["2025","2024"],"rows":[["Revenue","412.6","398.1"],["Operating profit","38.9","35.2"],["Capital expenditure","27.4","22.8"]]},"document":null,"metrics":[]},{"id":"ev_380347f3b756861a5e9c","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":3,"ordinal":10,"kind":"table_row","section":"Financial review \u203a Financial highlights (\u00a3 million)","text":"Financial highlights (\u00a3 million) \u2014 Revenue: 2025: 412.6; 2024: 398.1","bbox":[72.9,224.5,522.1,245.0],"extraction_method":"table","confidence":1.0,"table_ref":"p3-t1","cells":{"label":"Revenue","values":["412.6","398.1"],"headers":["2025","2024"],"caption":"Financial highlights (\u00a3 million)"},"document":null,"metrics":[]},{"id":"ev_88776a48b3f5efad5522","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":3,"ordinal":11,"kind":"table_row","section":"Financial review \u203a Financial highlights (\u00a3 million)","text":"Financial highlights (\u00a3 million) \u2014 Operating profit: 2025: 38.9; 2024: 35.2","bbox":[72.9,245.0,522.1,265.4],"extraction_method":"table","confidence":1.0,"table_ref":"p3-t1","cells":{"label":"Operating profit","values":["38.9","35.2"],"headers":["2025","2024"],"caption":"Financial highlights (\u00a3 million)"},"document":null,"metrics":[]},{"id":"ev_972030169a94066a6721","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":3,"ordinal":12,"kind":"table_row","section":"Financial review \u203a Financial highlights (\u00a3 million)","text":"Financial highlights (\u00a3 million) \u2014 Capital expenditure: 2025: 27.4; 2024: 22.8","bbox":[72.9,265.4,522.1,285.8],"extraction_method":"table","confidence":1.0,"table_ref":"p3-t1","cells":{"label":"Capital expenditure","values":["27.4","22.8"],"headers":["2025","2024"],"caption":"Financial highlights (\u00a3 million)"},"document":null,"metrics":[]},{"id":"ev_e3aa28d4bb5cf3743eb4","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":4,"ordinal":13,"kind":"heading","section":"Principal risks","text":"Principal risks","bbox":[72.5,87.6,202.4,113.8],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_e58c6018c6d3b17dc0ee","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":4,"ordinal":14,"kind":"paragraph","section":"Principal risks","text":"Energy and carbon costs. Natural gas and carbon allowance prices remain volatile. We hedge part of our gas requirement up to 18 months ahead and continue to invest in kiln efficiency.","bbox":[72.5,124.2,514.5,154.9],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_17a9b6e9c99d23ede154","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":4,"ordinal":15,"kind":"paragraph","section":"Principal risks","text":"Climate-related physical risk. Two plants are located near rivers with increasing flood risk. Flood defences at one site were upgraded in 2025.","bbox":[72.5,162.6,505.8,193.3],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_751f640fb2b9ef32e4f6","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":4,"ordinal":16,"kind":"paragraph","section":"Principal risks","text":"Regulatory change. Sustainability reporting requirements continue to evolve, and customers increasingly request product-level carbon data.","bbox":[72.5,201.1,508.3,231.8],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_d7eab6a15fd2b395116b","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":5,"ordinal":17,"kind":"heading","section":"Environmental performance","text":"Environmental performance","bbox":[72.5,87.6,324.8,113.8],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_afa0c81de20a11f02e11","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":5,"ordinal":18,"kind":"paragraph","section":"Environmental performance","text":"The company monitors operational energy consumption across its manufacturing facilities.","bbox":[72.5,124.2,494.7,139.6],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_b77ac9f337ad67257194","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":5,"ordinal":19,"kind":"paragraph","section":"Environmental performance","text":"In 2025 the Group's total energy consumption was 1,532,000 GJ (2024: 1,554,500 GJ).","bbox":[72.5,147.4,478.5,162.9],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[{"id":"met_01m4gcq8nr754rn37ekj1888nt","metric_key":"energy_total","value":1532000.0,"unit":"GJ","period_label":"FY2025"},{"id":"met_01m4gcq8nrf1x6wjr4ge5y5v4a","metric_key":"energy_total","value":1554500.0,"unit":"GJ","period_label":"FY2024"}]},{"id":"ev_8301dc0141f26ddf9f06","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":5,"ordinal":20,"kind":"paragraph","section":"Environmental performance","text":"Scope 1 emissions were 48,210 tCO2e and location-based Scope 2 emissions were 21,940 tCO2e in 2025. Streamlined Energy and Carbon Reporting disclosures are included in the Sustainability Report.","bbox":[72.5,170.7,519.6,216.5],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[{"id":"met_01m4gcq8nrcd6ds52gf86fq3fn","metric_key":"ghg_scope1","value":48210.0,"unit":"tCO2e","period_label":"FY2025"},{"id":"met_01m4gcq8nr9aa93gsjwz3ny33h","metric_key":"ghg_scope2_location","value":21940.0,"unit":"tCO2e","period_label":"FY2025"}]},{"id":"ev_024b912a2c732a3edeb8","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":6,"ordinal":21,"kind":"heading","section":"Corporate governance","text":"Corporate governance","bbox":[72.5,87.6,275.2,113.8],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_732d60c6ad7cf5d0a89d","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":6,"ordinal":22,"kind":"paragraph","section":"Corporate governance","text":"The Board comprises a non-executive Chair, two executive directors and five independent non-executive directors. The Sustainability Committee, chaired by an independent non-executive director, oversees climate strategy, health and safety, and environmental performance.","bbox":[72.5,124.2,513.9,170.1],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]},{"id":"ev_d99f2d5f645a971cfdbf","document_id":"doc_01m4gcq87gjpst1r4b40rc3z82","page":6,"ordinal":23,"kind":"paragraph","section":"Corporate governance","text":"The Audit and Risk Committee reviews the integrity of financial and non-financial reporting, including the processes used to collect environmental data.","bbox":[72.5,177.9,504.0,208.5],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":null,"metrics":[]}]