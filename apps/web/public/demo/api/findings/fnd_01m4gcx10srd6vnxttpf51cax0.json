595.0,842.0],[595.0,842.0],[595.0,842.0]],"superseded_at":null}},"ev_7c9bc9e364dbd9e8e7a5":{"id":"ev_7c9bc9e364dbd9e8e7a5","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":4,"ordinal":24,"kind":"paragraph","section":"Greenhouse gas emissions \u203a Performance","text":"In 2025, our gross Scope 1 emissions were 48,210 tCO2e, a 3.8% reduction compared with 2024, driven mainly by kiln heat-recovery projects. Scope 1 emissions arise from natural gas combustion in kilns and dryers, diesel used by mobile plant, and process emissions from clay.","bbox":[72.5,264.6,507.2,310.5],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":{"id":"doc_01m4gcq87e5k9e321mrzfz2y6h","title":"Aldermere Materials Group \u2014 Sustainability Report 2025","short_name":"Sustainability report FY2025","version":1,"doc_type":"sustainability_report","period_label":"FY2025","page_sizes":[[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0]],"superseded_at":null}},"ev_8059e8bb0c7bc2b5fb47":{"id":"ev_8059e8bb0c7bc2b5fb47","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":4,"ordinal":32,"kind":"paragraph","section":"Greenhouse gas emissions \u203a Performance \u203a Table 4: Greenhouse gas emissions","text":"GHG intensity covers Scope 1 and Scope 2 emissions per tonne of product.","bbox":[72.5,493.1,418.6,508.5],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":{"id":"doc_01m4gcq87e5k9e321mrzfz2y6h","title":"Aldermere Materials Group \u2014 Sustainability Report 2025","short_name":"Sustainability report FY2025","version":1,"doc_type":"sustainability_report","period_label":"FY2025","page_sizes":[[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0]],"superseded_at":null}},"ev_8080137dea4660994ecd":{"id":"ev_8080137dea4660994ecd","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":3,"ordinal":17,"kind":"paragraph","section":"Our approach to climate change \u203a Targets","text":"In the 2019 base year, Scope 1 and 2 emissions were 81,600 tCO2e. Base-year emissions are recalculated when acquisitions or divestments change emissions by more than 5%.","bbox":[72.5,245.5,500.9,276.1],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":{"id":"doc_01m4gcq87e5k9e321mrzfz2y6h","title":"Aldermere Materials Group \u2014 Sustainability Report 2025","short_name":"Sustainability report FY2025","version":1,"doc_type":"sustainability_report","period_label":"FY2025","page_sizes":[[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0]],"superseded_at":null}},"ev_85840771acb64d9d2f1f":{"id":"ev_85840771acb64d9d2f1f","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":7,"ordinal":52,"kind":"paragraph","section":"Reducing energy use and emissions","text":"Kiln heat-recovery projects at our Ashby and Kelso plants and the replacement of fourteen diesel loaders with electric models reduced Scope 1 emissions by 2,350 tCO2e in 2025 compared with 2024.","bbox":[72.5,124.2,521.6,170.1],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":{"id":"doc_01m4gcq87e5k9e321mrzfz2y6h","title":"Aldermere Materials Group \u2014 Sustainability Report 2025","short_name":"Sustainability report FY2025","version":1,"doc_type":"sustainability_report","period_label":"FY2025","page_sizes":[[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0]],"superseded_at":null}},"ev_a1014c2e5380f469990d":{"id":"ev_a1014c2e5380f469990d","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":3,"ordinal":16,"kind":"paragraph","section":"Our approach to climate change \u203a Targets","text":"We have committed to reduce absolute Scope 1 and 2 emissions by 42% by 2030 against a 2019 base year, and to reach net zero across our operations by 2050.","bbox":[72.5,207.0,520.4,237.7],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":{"id":"doc_01m4gcq87e5k9e321mrzfz2y6h","title":"Aldermere Materials Group \u2014 Sustainability Report 2025","short_name":"Sustainability report FY2025","version":1,"doc_type":"sustainability_report","period_label":"FY2025","page_sizes":[[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0]],"superseded_at":null}},"ev_f38d48c444a257dbd8bd":{"id":"ev_f38d48c444a257dbd8bd","document_id":"doc_01m4gcq87e5k9e321mrzfz2y6h","page":7,"ordinal":53,"kind":"paragraph","section":"Reducing energy use and emissions","text":"Efficiency projects delivered energy savings of 6,800 MWh in 2025 against the 2024 baseline, mainly through reduced natural gas use in kilns and dryers.","bbox":[72.5,177.9,508.5,208.5],"extraction_method":"text","confidence":1.0,"table_ref":null,"cells":null,"document":{"id":"doc_01m4gcq87e5k9e321mrzfz2y6h","title":"Aldermere Materials Group \u2014 Sustainability Report 2025","short_name":"Sustainability report FY2025","version":1,"doc_type":"sustainability_report","period_label":"FY2025","page_sizes":[[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0],[595.0,842.0]],"superseded_at":null}}},"reviews":[],"actions":[],"history":[{"finding_id":"fnd_01m4gcx10srd6vnxttpf51cax0","run_id":"run_01m4gcwx38x017m8c6wg7f8vyf","status":"supported","completeness":1.0,"requirement_set_id":"gri-302-305-2016@1.1.0","mode":"hybrid","created_at":"2026-10-09T13:16:03.560149+00:00"},{"finding_id":"fnd_01m4gcwwyg06bamaheyqvenjc6","run_id":"run_01m4gcq9cmbf3mze3bpf7pk5hk","status":"supported","completeness":1.0,"requirement_set_id":"gri-302-305-2016@1.0.0","mode":"hybrid","created_at":"2026-10-09T13:12:59.540933+00:00"}]}